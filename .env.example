# ----------------------------------------------------------------------------
# JiXora website — environment variables
# Copy to `.env.local` for local development. All variables prefixed with
# VITE_ are embedded into the public JavaScript bundle at build time, so never
# put secrets here. Server-side credentials belong in the form backend
# (see aws/lead-intake/README.md), not in this file.
# ----------------------------------------------------------------------------

# HTTPS endpoint that receives the lead and contact forms as JSON (POST).
# Options:
#   1. The AWS Lambda + Amazon SES function in aws/lead-intake (recommended)
#   2. Any JSON form service, e.g. https://formspree.io/f/<form-id>
# When unset, the forms validate input but do not pretend to submit: visitors
# are shown an error with a direct email link instead.
VITE_FORMS_ENDPOINT=

# Public site origin used for canonical URLs, Open Graph tags and the sitemap.
# Defaults to https://www.jixora.space when unset.
VITE_SITE_URL=https://www.jixora.space

# LinkedIn company page URL. Defaults to the page in src/data/site.js
# (https://www.linkedin.com/company/jixora.site/) when unset.
VITE_LINKEDIN_COMPANY_URL=
