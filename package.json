{
  "name": "jixora-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website for JiXora — AI program delivery and member accountability software for fitness businesses.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
